# Remote Kubernetes deployment for build/build-containers.sh and build/deploy.sh.
# Copy to build/remote.conf (gitignored; any build/*.conf except local.conf is)
# and adjust. KEY=VALUE lines only.
# SSH uses the key/certificate-based authentication already set up for the
# user; no passwords are stored here.

TARGET=remote

# Tag of the images built in the local Docker image store (<name>:<IMAGE_TAG>).
IMAGE_TAG=local

# Management node that has podman, gzip, and kubectl access to the cluster.
REMOTE_HOST=mgmt-node.cluster.local
REMOTE_USER=
REMOTE_PORT=22
# Optional private key; leave empty to use the SSH agent / ~/.ssh/config.
SSH_IDENTITY_FILE=
# Optional extra ssh arguments, e.g. -o StrictHostKeyChecking=accept-new
SSH_OPTIONS=

# Host name of the OPO Monitoring Ingress (DNS must point to the cluster's
# ingress controller); empty = the host in deploy/k8s/ingress.yaml.
# The remote cluster must already run an ingress controller for class nginx.
INGRESS_HOST=

# Directory on the management node for the transferred image tar files.
REMOTE_WORK_DIR=/tmp/analytics-agent-fwk-images

# Cluster registry; images are pushed as
# REMOTE_REGISTRY[/REMOTE_REGISTRY_PATH]/<name>:<REMOTE_IMAGE_TAG>.
REMOTE_REGISTRY=repo.cluster.local:5443
REMOTE_REGISTRY_PATH=
# Tag pushed to the registry. Empty = a new timestamp tag (YYYYmmddHHMMSS) per
# run, so nodes always pull the new images (manifests use IfNotPresent).
REMOTE_IMAGE_TAG=

PODMAN_CMD=podman
# Optional podman push flags, e.g. --tls-verify=false for a self-signed registry.
PODMAN_PUSH_OPTIONS=

# kubectl command on the management node.
REMOTE_KUBECTL=kubectl
