AGENT_RUNTIME_REPOSITORY_ROOT=.
AGENT_RUNTIME_DATABASE_PATH=./runtime-data/conversations.sqlite
AGENT_RUNTIME_REQUEST_TIMEOUT_SECONDS=30
AGENT_RUNTIME_MAXIMUM_STEPS=100
# PEM bundle trusted for the model gateway TLS connection (provider "azure" only).
AGENT_RUNTIME_CA_BUNDLE_PATH=

# "openai" uses MODEL_GATEWAY_MODEL; "azure" uses MODEL_GATEWAY_DEPLOYMENT +
# MODEL_GATEWAY_API_VERSION. Comment out the provider you are not using.
#MODEL_GATEWAY_PROVIDER=openai
#MODEL_GATEWAY_ENDPOINT=https://api.openai.com/v1
#MODEL_GATEWAY_MODEL=

MODEL_GATEWAY_PROVIDER=azure
MODEL_GATEWAY_ENDPOINT=
MODEL_GATEWAY_DEPLOYMENT=
MODEL_GATEWAY_API_VERSION=
MODEL_GATEWAY_API_KEY=

ANALYTICS_FOUNDATION_BASE_URL=
ANALYTICS_FOUNDATION_MCP_URL=http://127.0.0.1:8100/mcp

# This repo-root .env is also what build/deploy.sh reads Secret values from
# (see deploy/README.md#create-credentials); keep both a local and a
# remote/production LANADB_* block below and comment out whichever doesn't
# apply before running deploy.sh.
LANADB_JDBC_URL=jdbc:postgresql://127.0.0.1:5433/lanadb
LANADB_USERNAME=
LANADB_PASSWORD=
LANADB_MCP_URL=http://127.0.0.1:8400/mcp
LANADB_MCP_PORT=8400

#LANADB_JDBC_URL=jdbc:postgresql://<remote-database-host>:<port>/<database>
#LANADB_USERNAME=<remote database username>
#LANADB_PASSWORD=<remote database password>

