.vscode/
AnalyticsFoundation/mock_data/datawarehouse_wafers.json

# ai-enabled-analytics-v2/app-ui-service (Maven/Java build output)
target/
*.class

# v2 local dev / deploy scratch (docker save output, never committed)
ai-enabled-analytics-v2/deploy/*.tar

.run/

# Local secrets and machine-specific overrides. Never commit; .env.example is the template.
.env
.env.local

runtime-data/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Kubernetes deployment credentials are created locally and must not be committed.
/deploy/k8s/*.secret.env

# Cluster deployment configs for build/deploy.sh (only the local default is shared).
/build/*.conf
!/build/local.conf
