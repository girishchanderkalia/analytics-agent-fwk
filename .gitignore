.venv/
.venv-low-level-tests/
.pytest_cache/
*.egg-info/
__pycache__/
*.pyc
checkpoints.sqlite*
agent_sessions.sqlite*
.opo-monitoring.pid
.opo-monitoring.port
.opo-monitoring.log
.vscode/
AnalyticsFoundation/mock_data/datawarehouse_wafers.json

# ai-enabled-analytics-v2/app-ui-service (Maven/Java build output)
target/
*.class

# v2 local dev / deploy scratch (docker save output, never committed)
ai-enabled-analytics-v2/deploy/*.tar

.run/

# Local secrets and machine-specific overrides. Never commit; .env.example is the template.
.env
.env.local

# build/deploy.sh scratch files extracted from .env for kubectl --from-env-file;
# removed on exit, kept ignored in case cleanup is interrupted.
/.deploy-*.secret.env.tmp

runtime-data/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Kubernetes deployment credentials come from the repo-root .env (see
# deploy/README.md#create-credentials), not from files in this directory.

# Cluster deployment configs for build/deploy.sh (only the local default is shared).
/build/*.conf
!/build/local.conf
